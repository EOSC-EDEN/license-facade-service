{"version":2,"width":110,"height":22,"duration":25.0,"idle_time_limit":1.5,"title":"Normalize CC BY 4.0 with the DANS Labs LFS API","env":{"SHELL":"/bin/zsh","TERM":"xterm-256color"}}
[0.2,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[0.9,"o","SOURCE_LICENCE='CC BY 4.0'"]
[1.1,"o","\r\n"]
[1.5,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[2.2,"o","SPDX_ID='CC-BY-4.0'"]
[2.4,"o","\r\n"]
[2.8,"m","Preserve the source value"]
[3.0,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[4.2,"o","printf 'Source value: %s\\nCandidate SPDX ID: %s\\n' \"$SOURCE_LICENCE\" \"$SPDX_ID\""]
[4.4,"o","\r\n"]
[4.7,"o","Source value: CC BY 4.0\r\nCandidate SPDX ID: CC-BY-4.0\r\n"]
[5.8,"m","Validate the candidate with LFS"]
[6.0,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[7.5,"o","curl -fsS \"https://lfs.labs.dansdemo.nl/api/v1/licenses/$SPDX_ID/json\" -o normalized-license.json"]
[7.7,"o","\r\n"]
[9.0,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[11.5,"o","python3 -c \"import json; d=json.load(open('normalized-license.json')); print('SPDX ID:', d['licenseId']); print('Official name:', d['name']); print('Canonical LFS URI:', d['uri']); print('Deprecated:', d['isDeprecatedLicenseId'])\""]
[11.7,"o","\r\n"]
[12.5,"o","SPDX ID: CC-BY-4.0\r\n"]
[13.1,"o","Official name: Creative Commons Attribution 4.0 International\r\n"]
[13.7,"o","Canonical LFS URI: https://lfs.labs.dansdemo.nl/api/v1/licenses/94898055-10c4-56fa-bb75-9cd0b1d6d7c3\r\n"]
[14.3,"o","Deprecated: False\r\n"]
[15.5,"m","Retain the normalization evidence"]
[15.7,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[17.0,"o","printf 'Preserve: %s  ->  %s\\n' \"$SOURCE_LICENCE\" \"$SPDX_ID\""]
[17.2,"o","\r\n"]
[17.6,"o","Preserve: CC BY 4.0  ->  CC-BY-4.0\r\n"]
[19.0,"o","\r\n\u001b[1;36mLFS verified the candidate; retain both values with the API response as evidence.\u001b[0m\r\n"]
[20.5,"o","\u001b[1;32marchive@terminal\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
